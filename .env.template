# ── Self-Improving Research Assistant — environment template ─────────────────
# Copy this file to `.env` and fill in real values. Never commit `.env`.
#
# Confidence key (checked against installed SDK / official docs on 2026-09-10):
#   [confirmed]  name verified against the installed package or vendor docs
#   [verify]     best guess — confirm against the vendor dashboard/docs before relying on it

# ── LLM backend (Cognee needs one for entity/relationship extraction + embeddings) ──
LLM_API_KEY=                       # [confirmed] Cognee reads this generic var, or provider-specific below
LLM_PROVIDER=openai                # openai | anthropic | ollama | ... (see docs.cognee.ai)
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=                    # [confirmed] set if LLM_PROVIDER=openai

# ── Cognee.ai — Memory Construction Layer (ECL: Extract, Cognify, Load) ──
COGNEE_API_KEY=                    # [verify] only needed if using Cognee Cloud instead of self-hosted

# ── HydraDB — Memory Storage & Serving Layer (object-store-native graph DB) ──
HYDRADB_API_KEY=                   # [confirmed] passed as `token=` to hydra_db.HydraDB(...)
HYDRADB_BASE_URL=https://api.hydradb.com   # [confirmed] SDK default; override for local/self-hosted instance
HYDRADB_DATABASE=research_assistant        # [verify] your instance's database/tenant name

# ── hotdata.dev — Live Query & Analytics Layer ──
HOTDATA_API_KEY=                   # [confirmed] required by hotdata_framework.from_env()
HOTDATA_API_URL=https://api.hotdata.dev   # [confirmed] this is the library's own default; override only for a custom host
HOTDATA_WORKSPACE=                 # [confirmed] optional; auto-discovered if blank

# ── RocketRide.ai — Motion / Orchestration Layer ──
ROCKETRIDE_API_KEY=                # [verify] generate at staging.rocketride.ai after adding hackathon credits
ROCKETRIDE_ENGINE_URL=             # [verify] staging vs. cloud engine URL — confirm in RocketRide staging guide

# ── Modiqo.ai Rote — Muscle-Memory / Reliability Layer ──
# Rote is a local CLI (github.com/modiqo/rote-releases), not a pip package.
# Install it separately, sign in with Google/GitHub, then confirm it can reach
# your target API before the hackathon starts (per the official setup checklist).
ROTE_WORKSPACE=                    # [verify] handle/workspace chosen during `rote` sign-in

# ── Snyk (required security gate, not a pipeline layer) ──
SNYK_TOKEN=                        # [verify] from app.snyk.io — used by `snyk test` in CI/scripts, not by the agent
